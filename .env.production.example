# Contoh konfigurasi untuk deploy di SUB-DIREKTORI.
#
# Salin berkas ini menjadi `.env` di folder yang sama, lalu sesuaikan nilainya.
# Docker Compose membaca `.env` secara otomatis, jadi berkas ini yang menentukan
# nilai build frontend tanpa perlu mengedit docker-compose.yml.
#
#   cp .env.production.example .env
#
# PERHATIAN: ketiga nilai di bawah harus memakai nama sub-jalur yang SAMA.
# Garis miring di akhir VITE_BASE_PATH wajib ada.

# Sub-jalur tempat aplikasi dipasang. Ditanamkan Vite ke index.html saat build,
# jadi mengubahnya berarti build ulang image, bukan sekadar restart.
# Untuk menaruh di akar domain, isi dengan /
VITE_BASE_PATH=/stunting-balita/

# Alamat API dari sudut pandang PERAMBAN. Harus relatif terhadap domain, bukan
# localhost, karena yang memanggilnya adalah peramban pengguna.
VITE_API_URL=/stunting-balita/api

# WAJIB 'false' di produksi.
# Kalau 'true', peramban akan menghitung sendiri ketika API tidak terjangkau —
# sehingga alamat API yang salah tidak memunculkan galat apa pun dan aplikasi
# tetap tampak benar padahal server tidak pernah dipanggil.
VITE_ALLOW_LOCAL_FALLBACK=false

# Alamat publik aplikasi. Dipakai Laravel untuk pembentukan URL.
APP_URL=https://domainku.com/stunting-balita
