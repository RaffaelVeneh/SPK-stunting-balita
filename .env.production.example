# ============================================================================
# Konfigurasi PRODUKSI (deploy di sub-direktori)
#   cp .env.production.example .env
#
# Berkas .env SUDAH diabaikan git, jadi rahasia di bawah tidak akan ter-commit.
# Jangan pernah menyalin isi berkas ini ke docker-compose.yml.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. SUB-JALUR
# ---------------------------------------------------------------------------
# Ketiganya WAJIB memakai nama sub-jalur yang sama. Garis miring di akhir
# VITE_BASE_PATH wajib ada.
#
# Nilai ini ditanamkan Vite SAAT BUILD, bukan saat container jalan. Jadi
# mengubahnya berarti build ulang (`docker compose up -d --build`), bukan
# sekadar restart.
VITE_BASE_PATH=/stunting-balita/
VITE_API_URL=/stunting-balita/api

# WAJIB 'false' di produksi. Kalau 'true', peramban akan menghitung sendiri
# ketika API tidak terjangkau — sehingga alamat API yang salah tidak
# memunculkan galat apa pun dan aplikasi tetap tampak benar padahal server
# tidak pernah dipanggil.
VITE_ALLOW_LOCAL_FALLBACK=false

# ---------------------------------------------------------------------------
# 2. APLIKASI
# ---------------------------------------------------------------------------
APP_NAME=SPK Stunting UNY
APP_ENV=production
APP_DEBUG=false

# Alamat publik. Dipakai Laravel untuk membentuk URL absolut.
APP_URL=https://segara.slemankab.go.id/stunting-balita

# ---------------------------------------------------------------------------
# 3. KUNCI APLIKASI  -- WAJIB DIISI
# ---------------------------------------------------------------------------
# Jalankan perintah ini di VPS, lalu tempel hasilnya:
#
#   docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
#
# Kunci ini mengenkripsi sesi dan cookie. Kalau bocor, siapa pun bisa
# memalsukan sesi. JANGAN dibiarkan kosong: kalau kosong, aplikasi akan
# memakai kunci pengembangan yang tertulis di repo publik ini.
APP_KEY=

# ---------------------------------------------------------------------------
# 4. BASIS DATA  -- GANTI SANDINYA
# ---------------------------------------------------------------------------
# PENTING: nilai ini hanya dipakai saat volume MySQL dibuat PERTAMA KALI.
# Kalau Anda mengubahnya setelah volume ada, MySQL TIDAK akan ikut berubah,
# dan backend akan gagal menyambung. Untuk deploy baru, isi dulu sebelum
# `docker compose up` yang pertama.
#
# Kalau sudah terlanjur jalan dan ingin mengganti sandi, pilihannya hanya dua:
# ganti sandi dari dalam MySQL, atau hapus volume (data hilang).
MYSQL_DATABASE=spk_stunting
MYSQL_USER=spk_user
MYSQL_PASSWORD=GANTI_SANDI_KUAT
MYSQL_ROOT_PASSWORD=GANTI_SANDI_ROOT_LAIN
# ---------------------------------------------------------------------------
# 5. PORT HOST  --  WAJIB DIUBAH KALAU ADA APLIKASI LAIN DI VPS
# ---------------------------------------------------------------------------
# Stack ini hanya butuh SATU port yang terjangkau reverse proxy, yaitu
# FRONTEND_PORT. Sisanya hanya untuk administrasi dan boleh dibiarkan tertutup.
#
# PENTING: tiga port bawaan BENTROK dengan stack `segara` yang sudah berjalan
# di VPS yang sama:
#
#     port 8000  dipakai segara-webserver
#     port 3307  dipakai segara-db
#     port 6380  dipakai segara-redis
#
# Kalau dibiarkan, container SPK gagal start dengan "port is already allocated".
# Lebih berbahaya lagi: kalau segara sedang MATI saat SPK dinyalakan, SPK akan
# merebut port itu, sehingga segara gagal start saat dinyalakan kembali. Itu
# gangguan pada layanan yang sedang berjalan.
#
# Nilai di bawah sudah dipilih agar tidak bertabrakan dengan segara.
FRONTEND_PORT=3000
BACKEND_PORT=8010
MYSQL_PORT=3317
REDIS_PORT=6390
PMA_PORT=8082

# ---------------------------------------------------------------------------
# 6. IMAGE  --  HANYA PERLU DIISI KALAU JARINGAN VPS SERING GAGAL MENARIK
# ---------------------------------------------------------------------------
# Kalau `docker compose up` gagal dengan "TLS handshake timeout", cara paling
# cepat adalah memakai image yang SUDAH ADA di VPS, bukan mengunduh lagi.
#
# Stack `segara` di VPS yang sama sudah memakai:
#     mysql:8.4     dan     redis:alpine
#
# Periksa yang tersedia dengan:  docker images
#
# Kalau `redis:alpine` ada di daftar itu, isi baris berikut supaya tidak ada
# unduhan sama sekali. Perhatikan bahwa `redis:alpine` adalah tag mengambang:
# ia bisa berpindah versi mayor saat ditarik ulang, berbeda dengan
# `redis:7-alpine` yang terpaku.
#REDIS_IMAGE=redis:alpine
#MYSQL_IMAGE=mysql:8.4
#PMA_IMAGE=phpmyadmin/phpmyadmin:latest
