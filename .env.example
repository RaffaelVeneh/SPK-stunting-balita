# ============================================================================
# Konfigurasi PENGEMBANGAN LOKAL
#   cp .env.example .env
#
# Berkas ini sebenarnya opsional: semua nilai di bawah sudah menjadi nilai
# cadangan di docker-compose.yml, jadi `docker compose up -d --build` tetap
# jalan tanpa .env. Berkas ini ada supaya Anda bisa mengubahnya secara sadar.
# ============================================================================

# Di laptop aplikasi berada di akar, jadi cukup /
VITE_BASE_PATH=/
VITE_API_URL=/api

# Boleh 'true' saat mengembangkan tanpa backend, karena peramban akan
# menghitung sendiri. JANGAN 'true' di produksi.
VITE_ALLOW_LOCAL_FALLBACK=false

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000

# Sandi basis data pengembangan. Bebas, karena hanya terjangkau dari localhost.
MYSQL_DATABASE=spk_stunting
MYSQL_USER=spk_user
MYSQL_PASSWORD=spk_password
MYSQL_ROOT_PASSWORD=rootpassword

# Biarkan kosong agar memakai kunci pengembangan di docker-compose.yml.
APP_KEY=